{
  "name": "reference-tabs",
  "displayName": "Reference Tabs",
  "description": "Browse semantic references in a clickable editor tab.",
  "version": "0.1.0",
  "publisher": "local-reference-tools",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "referenceTabs.show",
      "title": "Find All References in Tab"
    }],
    "menus": {
      "editor/context": [{ "command": "referenceTabs.show", "group": "navigation@50" }]
    }
  }
}
